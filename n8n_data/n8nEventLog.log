ath\\\":\\\"src/BodoFood/OrderBundle/Services/GetDeliveryInfoUseCase/GetOrderDeliveryInfoUseCase.php\\\",\\\"old_path\\\":\\\"src/BodoFood/OrderBundle/Services/GetDeliveryInfoUseCase/GetOrderDeliveryInfoUseCase.php\\\",\\\"a_mode\\\":\\\"100644\\\",\\\"b_mode\\\":\\\"100644\\\",\\\"new_file\\\":false,\\\"renamed_file\\\":false,\\\"deleted_file\\\":false,\\\"generated_file\\\":false},{\\\"diff\\\":\\\"@@ -31,7 +31,22 @@ final class NewDeliveryPriceCalculator\\\\n      */\\\\n     public function applyNewDeliveryPrice(Order $order, float $relatedPriceToDelivery): float\\\\n     {\\\\n-        if ($order->isExpress() || !$this->featureFlag->shouldConsiderForOrder($order)) {\\\\n+        if ($order->isExpress()) {\\\\n+            return $relatedPriceToDelivery;\\\\n+        }\\\\n+\\\\n+        return $this->applyNewDeliveryPriceForOwnDelivery($order, $relatedPriceToDelivery);\\\\n+    }\\\\n+\\\\n+    /**\\\\n+     * @param Order $order\\\\n+     * @param float $relatedPriceToDelivery\\\\n+     *\\\\n+     * @return float\\\\n+     */\\\\n+    public function applyNewDeliveryPriceForOwnDelivery(Order $order, float $relatedPriceToDelivery): float\\\\n+    {\\\\n+        if (!$this->featureFlag->shouldConsiderForOrder($order)) {\\\\n             return $relatedPriceToDelivery;\\\\n         }\\\\n \\\\n\\\",\\\"collapsed\\\":false,\\\"too_large\\\":false,\\\"new_path\\\":\\\"src/BodoFood/OrderBundle/Services/NewDeliveryPriceCalculator.php\\\",\\\"old_path\\\":\\\"src/BodoFood/OrderBundle/Services/NewDeliveryPriceCalculator.php\\\",\\\"a_mode\\\":\\\"100644\\\",\\\"b_mode\\\":\\\"100644\\\",\\\"new_file\\\":false,\\\"renamed_file\\\":false,\\\"deleted_file\\\":false,\\\"generated_file\\\":false}]\"],\"options\":{\"openai_api_key\":{\"lc\":1,\"type\":\"secret\",\"id\":[\"OPENAI_API_KEY\"]},\"model\":\"gpt-4o\",\"timeout\":60000,\"max_retries\":2,\"configuration\":{\"baseURL\":\"https://api.avalai.ir/v1\",\"fetchOptions\":{}},\"model_kwargs\":{}},\"response\":{\"response\":